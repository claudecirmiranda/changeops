# ChangeOps local stack — environment variables
# Copy this file to .env and adjust values before running: docker compose up -d

# PostgreSQL
POSTGRES_DB=changeops
POSTGRES_USER=changeops
POSTGRES_PASSWORD=changeops
POSTGRES_APP_PASSWORD=changeops_app_pass

# change-service DB credentials (must match above)
DB_USER=changeops
DB_PASS=changeops

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
