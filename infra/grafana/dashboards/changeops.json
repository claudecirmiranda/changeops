{
  "id": null,
  "uid": "changeops-main",
  "title": "ChangeOps Dashboard",
  "tags": ["changeops"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Changes Created (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "expr": "sum(changes_by_status)",
        "legendFormat": "Total"
      }]
    },
    {
      "id": 2,
      "title": "Events Published (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "expr": "sum(events_published_total)",
        "legendFormat": "Published"
      }]
    },
    {
      "id": 3,
      "title": "Events Consumed (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{
        "expr": "sum(events_consumed_total)",
        "legendFormat": "Consumed"
      }]
    },
    {
      "id": 4,
      "title": "Events Failed (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "red", "mode": "fixed" } }
      },
      "targets": [{
        "expr": "sum(events_failed_total)",
        "legendFormat": "Failed"
      }]
    },
    {
      "id": 5,
      "title": "API Request Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application='change-service'}[5m])) by (le, method))",
        "legendFormat": "p95 {{method}}"
      }]
    },
    {
      "id": 6,
      "title": "Changes by Status",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "sum by (status) (changes_by_status)",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 7,
      "title": "Events Published Rate (per min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rate(events_published_total[1m]) * 60",
          "legendFormat": "Published/min"
        },
        {
          "expr": "rate(events_consumed_total[1m]) * 60",
          "legendFormat": "Consumed/min"
        },
        {
          "expr": "rate(events_failed_total[1m]) * 60",
          "legendFormat": "Failed/min"
        }
      ]
    }
  ]
}
