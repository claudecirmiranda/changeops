{
  "id": null,
  "uid": "changeops-main",
  "version": 2,
  "title": "ChangeOps Dashboard",
  "tags": ["changeops"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "id": 20,
      "title": "Changes",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "title": "Changes - Total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "targets": [{
        "expr": "sum(changes_by_status)",
        "legendFormat": "Total",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 25,
      "title": "Changes - Created (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "fieldConfig": {
        "defaults": { "decimals": 0 }
      },
      "targets": [{
        "expr": "sum(changes_created_total)",
        "legendFormat": "Created",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 8,
      "title": "Changes - Completed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "fieldConfig": {
        "defaults": { "decimals": 0, "color": { "fixedColor": "green", "mode": "fixed" } }
      },
      "targets": [{
        "expr": "changes_by_status{status='COMPLETED'}",
        "legendFormat": "Completed",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 9,
      "title": "Changes - Failed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": { "decimals": 0, "color": { "fixedColor": "red", "mode": "fixed" } }
      },
      "targets": [{
        "expr": "changes_by_status{status='FAILED'}",
        "legendFormat": "Failed",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 10,
      "title": "Changes - Prepared",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": { "decimals": 0, "color": { "fixedColor": "blue", "mode": "fixed" } }
      },
      "targets": [{
        "expr": "changes_by_status{status='PREPARED'}",
        "legendFormat": "Prepared",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 6,
      "title": "Changes - By Status",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "COMPLETED" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "FAILED" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "PREPARED" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          }
        ]
      },
      "targets": [{
        "expr": "sum by (status) (changes_by_status{status=~'COMPLETED|FAILED|PREPARED'})",
        "legendFormat": "{{status}}",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 5,
      "title": "API Latency (p95)",
      "description": "Latência p95 das requisições REST ao longo do tempo.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job='change-service'}[5m])))",
          "legendFormat": "change-service p95",
          "interval": "30s"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job='deploy-orchestrator'}[5m])))",
          "legendFormat": "deploy-orchestrator p95",
          "interval": "30s"
        }
      ]
    },
    {
      "id": 21,
      "title": "Events",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "panels": []
    },
    {
      "id": 2,
      "title": "Events - Published (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "decimals": 0 }
      },
      "maxDataPoints": 100,
      "targets": [{
        "expr": "sum(increase(events_published_total[$__range]))",
        "legendFormat": "Published",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 3,
      "title": "Events - Consumed (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 14 },
      "fieldConfig": {
        "defaults": { "decimals": 0 }
      },
      "maxDataPoints": 100,
      "targets": [{
        "expr": "sum(increase(events_consumed_total[$__range]))",
        "legendFormat": "Consumed",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 4,
      "title": "Events - Failed (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 14 },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "decimals": 0 }
      },
      "maxDataPoints": 100,
      "targets": [{
        "expr": "sum(increase(events_failed_total[$__range]))",
        "legendFormat": "Failed",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 23,
      "title": "Events - DLT (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 14 },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "dark-red", "mode": "fixed" }, "decimals": 0 }
      },
      "maxDataPoints": 100,
      "targets": [{
        "expr": "sum(increase(events_dlt_total[$__range]))",
        "legendFormat": "DLT",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 24,
      "title": "Events - Discarded (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 14 },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "purple", "mode": "fixed" }, "decimals": 0 }
      },
      "maxDataPoints": 100,
      "targets": [{
        "expr": "sum(increase(events_discarded_total[$__range]))",
        "legendFormat": "Discarded",
        "instant": true,
        "interval": "5s"
      }]
    },
    {
      "id": 7,
      "title": "Events - Rate (per min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "maxDataPoints": 100,
      "targets": [
        {
          "expr": "sum(rate(events_published_total[$__rate_interval])) * 60",
          "legendFormat": "Published/min",
          "interval": "30s"
        },
        {
          "expr": "sum(rate(events_consumed_total[$__rate_interval])) * 60",
          "legendFormat": "Consumed/min",
          "interval": "30s"
        },
        {
          "expr": "sum(rate(events_failed_total[$__rate_interval])) * 60",
          "legendFormat": "Failed/min",
          "interval": "30s"
        }
      ]
    },
    {
      "id": 22,
      "title": "Orchestration",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "id": 26,
      "title": "Orchestration Latency (p95)",
      "description": "Latência p95 do processamento de DeployFinishedEvent no orquestrador.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2.0 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(orchestration_duration_seconds_bucket[5m])))",
        "legendFormat": "p95",
        "interval": "30s"
      }]
    }
  ]
}
